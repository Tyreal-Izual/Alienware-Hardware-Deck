<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HardwareDeck" Width="1600" Height="900" MinWidth="1040" MinHeight="640"
        Background="#0B1117" Foreground="#E8F0F6" FontFamily="Segoe UI" Language="en-US"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#111C25"/>
      <Setter Property="BorderBrush" Value="#243440"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9CAEBB"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/>
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="FontSize" Value="48"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#F4F8FC"/>
    </Style>
    <Style x:Key="Detail" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/><Setter Property="Margin" Value="0,3,8,0"/>
      <Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#F4F8FC"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DCE8F2"/><Setter Property="Background" Value="#1B2B38"/>
      <Setter Property="BorderBrush" Value="#304554"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3,0"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A4051"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#63DCBD"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#334F61"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#DCE8F2"/><Setter Property="Background" Value="#182733"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#2A4051"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#23483F"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="118"/><Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="8,5"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ModeSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="CurrentMark" Text="✓" Visibility="Collapsed" Margin="0,0,6,0"/>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A4051"/></Trigger>
          <Trigger Property="Tag" Value="Current">
            <Setter Property="Background" Value="#17463C"/><Setter Property="BorderBrush" Value="#50D7B2"/>
            <Setter Property="Foreground" Value="#D2FFF0"/><Setter TargetName="CurrentMark" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="Tag" Value="Pending">
            <Setter Property="Background" Value="#3E3421"/><Setter Property="BorderBrush" Value="#E4B77A"/><Setter Property="Foreground" Value="#FFE6B3"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#8EB8FF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeSurface" Property="Opacity" Value="0.45"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Current"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
            <Setter TargetName="ModeSurface" Property="Opacity" Value="1"/>
          </MultiTrigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Pending"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
            <Setter TargetName="ModeSurface" Property="Opacity" Value="1"/>
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#DCE8F2"/><Setter Property="Background" Value="#182733"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="30"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="ToggleSurface" Background="#182733" BorderBrush="#304554" BorderThickness="1" CornerRadius="6">
                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#9CAEBB" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#2A4051"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,28,0"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#182733" BorderBrush="#304554" BorderThickness="1" CornerRadius="6" Padding="3"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.8"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/><Setter Property="Margin" Value="0,8,0,12"/>
      <Setter Property="Background" Value="#253642"/><Setter Property="Foreground" Value="#50D7B2"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
          <Border x:Name="PART_Track"/>
          <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#1B2B38"/><Setter Property="Foreground" Value="#E8F0F6"/>
      <Setter Property="BorderBrush" Value="#304554"/><Setter Property="Padding" Value="10"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#0B1117"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Command="ScrollBar.PageUpCommand" Focusable="False">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb x:Name="ScrollThumb" Margin="2,2" MinHeight="24">
              <Thumb.Template><ControlTemplate TargetType="Thumb">
                <Border x:Name="ThumbSurface" Background="#304554" CornerRadius="3"/>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#577083"/></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#50D7B2"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Command="ScrollBar.PageDownCommand" Focusable="False">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/>
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/><Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/>
            <Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand"/>
            <Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer x:Name="Viewport" Background="#0B1117" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="Dashboard" Margin="20,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="Header" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
          <TextBlock Text="HardwareDeck" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="MachineName" Text="Identifying hardware..." Style="{StaticResource Label}" Margin="1,3,0,0" MaxWidth="300"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#7F93A3" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="LiveState" Text="CONNECTING" FontSize="10" FontWeight="SemiBold" Foreground="#9CAEBB"/>
          </StackPanel>
          <TextBlock x:Name="Footer" Text="Local monitoring · 1 s refresh" Style="{StaticResource Label}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AdminButton" Content="Enable sensors" Background="#173D35" BorderBrush="#29584C"/>
            <Button x:Name="ScreenButton" Content="Next display"/>
            <Button x:Name="PinButton" Content="Pin: off"/>
            <Button x:Name="FullButton" Content="Fullscreen" ToolTip="Toggle fullscreen (F11). Press Esc to leave."/>
            <ComboBox x:Name="Interval" Width="67" SelectedIndex="0" Margin="7,0,0,0" ToolTip="Refresh interval">
              <ComboBoxItem Content="1 s"/><ComboBoxItem Content="2 s"/><ComboBoxItem Content="5 s"/>
            </ComboBox>
          </StackPanel>
          <TextBlock x:Name="Clock" Text="--:--:--" FontSize="11" Foreground="#9CAEBB" HorizontalAlignment="Right" Margin="0,6,1,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="CpuCard" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="01 / PROCESSOR" Style="{StaticResource Section}" Foreground="#50D7B2"/>
            <TextBlock x:Name="CpuName" Text="CPU" FontSize="16" Margin="0,5,0,10" TextTrimming="CharacterEllipsis"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Utilization" Style="{StaticResource Label}"/><TextBlock x:Name="CpuLoad" Text="—" Style="{StaticResource Metric}"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock x:Name="CpuTempLabel" Text="CPU temperature source" Style="{StaticResource Label}"/><TextBlock x:Name="CpuTemp" Text="—" Style="{StaticResource Metric}" Foreground="#50D7B2"/></StackPanel>
            </Grid>
            <ProgressBar x:Name="CpuBar" Maximum="100"/>
            <UniformGrid Columns="4">
              <StackPanel><TextBlock Text="Frequency (est.)" Style="{StaticResource Label}"/><TextBlock x:Name="CpuFrequency" Text="—" Style="{StaticResource Detail}"/></StackPanel>
              <StackPanel><TextBlock Text="Package power / limit" Style="{StaticResource Label}"/><TextBlock x:Name="CpuPower" Text="—" Style="{StaticResource Detail}"/></StackPanel>
              <StackPanel><TextBlock Text="CPU voltage" Style="{StaticResource Label}"/><TextBlock x:Name="CpuVoltage" Text="Unavailable" Style="{StaticResource Detail}"/></StackPanel>
              <StackPanel><TextBlock Text="Memory (GiB)" Style="{StaticResource Label}"/><TextBlock x:Name="Ram" Text="—" Style="{StaticResource Detail}"/></StackPanel>
            </UniformGrid>
            <TextBlock x:Name="CpuHint" Text="Waiting for temperature source" Style="{StaticResource Label}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="GpuCard" Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="02 / GRAPHICS" Style="{StaticResource Section}" Foreground="#8EB8FF"/>
            <TextBlock x:Name="GpuName" Text="NVIDIA GPU" FontSize="16" Margin="0,5,0,10" TextTrimming="CharacterEllipsis"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Utilization" Style="{StaticResource Label}"/><TextBlock x:Name="GpuLoad" Text="—" Style="{StaticResource Metric}"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="GPU temperature" Style="{StaticResource Label}"/><TextBlock x:Name="GpuTemp" Text="—" Style="{StaticResource Metric}" Foreground="#8EB8FF"/></StackPanel>
            </Grid>
            <ProgressBar x:Name="GpuBar" Foreground="#8EB8FF" Maximum="100"/>
            <UniformGrid Columns="4">
              <StackPanel><TextBlock Text="Core clock" Style="{StaticResource Label}"/><TextBlock x:Name="GpuFrequency" Text="—" Style="{StaticResource Detail}"/></StackPanel>
              <StackPanel><TextBlock Text="Power / limit" Style="{StaticResource Label}"/><TextBlock x:Name="Power" Text="—" Style="{StaticResource Detail}"/></StackPanel>
              <StackPanel><TextBlock Text="Fan speed" Style="{StaticResource Label}"/><TextBlock x:Name="GpuFan" Text="—" Style="{StaticResource Detail}"/></StackPanel>
              <StackPanel><TextBlock Text="VRAM (GiB)" Style="{StaticResource Label}"/><TextBlock x:Name="Vram" Text="—" Style="{StaticResource Detail}"/></StackPanel>
            </UniformGrid>
            <TextBlock x:Name="GpuHint" Text="Connecting to NVIDIA NVML..." Style="{StaticResource Label}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
      <Border x:Name="CoolingCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
        <StackPanel>
          <DockPanel Margin="4,0,4,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock x:Name="ModeCurrent" Text="Current: connecting" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="ModeQuiet" Content="Quiet" Style="{StaticResource ModeButton}" IsEnabled="False"/>
              <Button x:Name="ModeBalanced" Content="Balanced" Style="{StaticResource ModeButton}" IsEnabled="False"/>
              <Button x:Name="ModePerformance" Content="Performance" Style="{StaticResource ModeButton}" IsEnabled="False"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="03 / PERFORMANCE &amp; COOLING" Style="{StaticResource Section}" Foreground="#E4B77A"/>
              <TextBlock x:Name="FanSummary" Text="Waiting for fan sensors" Style="{StaticResource Label}" Margin="0,3,12,0"/>
            </StackPanel>
          </DockPanel>
          <StackPanel x:Name="PresetDetails" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,0,4,4">
            <TextBlock Text="Cooling" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Width="54" MinWidth="54" Height="30" x:Name="CoolingQuiet" Content="Q" Style="{StaticResource ModeButton}" IsEnabled="False"/>
            <Button Width="54" MinWidth="54" Height="30" x:Name="CoolingBalanced" Content="B" Style="{StaticResource ModeButton}" IsEnabled="False"/>
            <Button Width="54" MinWidth="54" Height="30" x:Name="CoolingPerformance" Content="P" Style="{StaticResource ModeButton}" IsEnabled="False"/>
            <TextBlock Text="OC" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="18,0,8,0"/>
            <Button Width="76" MinWidth="62" Height="30" x:Name="CpuOff" Content="Off" Style="{StaticResource ModeButton}" IsEnabled="False"/>
            <Button Width="76" MinWidth="62" Height="30" x:Name="CpuOC01" Content="OC01" Style="{StaticResource ModeButton}" IsEnabled="False"/>
            <Button Width="76" MinWidth="62" Height="30" x:Name="CpuOC02" Content="OC02" Style="{StaticResource ModeButton}" IsEnabled="False"/>
          </StackPanel>
          <UniformGrid x:Name="FanPanel" Rows="1"/>
          <UniformGrid x:Name="TemperaturePanel" Rows="1" Margin="0,4,0,0"/>
          <Grid Margin="4,7,4,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock x:Name="AwccState" Text="Connecting to AWCC..." Style="{StaticResource Label}" Margin="0,0,16,0"/>
            <TextBlock x:Name="ModeNotice" Grid.Column="1" Text="Waiting for CPU and cooling verification" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>
      <Grid x:Name="HistoryPanel" Grid.Row="3" MinHeight="158" Height="220" VerticalAlignment="Top" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="CpuHistoryCard" Style="{StaticResource Card}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
              <TextBlock x:Name="CpuChartCurrent" DockPanel.Dock="Right" Text="—" Foreground="#50D7B2" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="12,0,0,0"/>
              <TextBlock x:Name="CpuChartTitle" Text="CPU temperature source · 120 s" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            </DockPanel>
            <Canvas x:Name="CpuChart" Grid.Row="1" MinHeight="90" Background="Transparent" ClipToBounds="True" Margin="0,6,0,4"/>
            <TextBlock x:Name="CpuChartSummary" Grid.Row="2" Text="Waiting for samples" Style="{StaticResource Label}"/>
          </Grid>
        </Border>
        <Border x:Name="GpuHistoryCard" Grid.Column="2" Style="{StaticResource Card}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
              <TextBlock x:Name="GpuChartCurrent" DockPanel.Dock="Right" Text="—" Foreground="#8EB8FF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="12,0,0,0"/>
              <TextBlock Text="GPU temperature · 120 s" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            </DockPanel>
            <Canvas x:Name="GpuChart" Grid.Row="1" MinHeight="90" Background="Transparent" ClipToBounds="True" Margin="0,6,0,4"/>
            <TextBlock x:Name="GpuChartSummary" Grid.Row="2" Text="Waiting for samples" Style="{StaticResource Label}"/>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="NetworkHistoryPanel" Grid.Row="4" MinHeight="158" Height="220" VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="DownloadHistoryCard" Style="{StaticResource Card}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
              <TextBlock x:Name="DownloadChartCurrent" DockPanel.Dock="Right" Text="—" Foreground="#8EB8FF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="12,0,0,0"/>
              <TextBlock x:Name="DownloadChartTitle" Text="Network download · 120 s" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            </DockPanel>
            <Canvas x:Name="DownloadChart" Grid.Row="1" MinHeight="90" Background="Transparent" ClipToBounds="True" Margin="0,6,0,4"/>
            <TextBlock x:Name="DownloadChartSummary" Grid.Row="2" Text="Collecting network samples" Style="{StaticResource Label}"/>
          </Grid>
        </Border>
        <Border x:Name="UploadHistoryCard" Grid.Column="2" Style="{StaticResource Card}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
              <TextBlock x:Name="UploadChartCurrent" DockPanel.Dock="Right" Text="—" Foreground="#50D7B2" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="12,0,0,0"/>
              <TextBlock x:Name="UploadChartTitle" Text="Network upload · 120 s" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            </DockPanel>
            <Canvas x:Name="UploadChart" Grid.Row="1" MinHeight="90" Background="Transparent" ClipToBounds="True" Margin="0,6,0,4"/>
            <TextBlock x:Name="UploadChartSummary" Grid.Row="2" Text="Collecting network samples" Style="{StaticResource Label}"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>
